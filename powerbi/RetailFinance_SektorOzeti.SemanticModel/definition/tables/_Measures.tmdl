	measure 'DQ Explained' =
			VAR _n = CALCULATE ( COUNTROWS ( dq_results ), dq_results[result] = "EXPLAINED" )
			RETURN
			    IF ( ISBLANK ( _n ), 0, _n )
		formatString: 0
		displayFolder: B Veri kalitesi
