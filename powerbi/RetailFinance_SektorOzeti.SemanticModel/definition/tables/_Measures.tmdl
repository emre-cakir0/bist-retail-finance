	measure 'EBITDA Margin Q' = DIVIDE ( [EBITDA Q], [Revenue Q] )
		formatString: 0.0%
		displayFolder: 8 Çeyreklik (nominal)
		lineageTag: 4009a3f3-c88d-58c1-b761-3590dd599b34

	measure 'Revenue QoQ (nominal)' =
			VAR _idx = [Selected Index]
			VAR _cur = [Revenue Q]
			VAR _prev =
			    CALCULATE ( [Revenue Q], FILTER ( ALL ( dim_date ), dim_date[period_index] = _idx - 1 ) )
			RETURN
			    IF ( ISBLANK ( _prev ) || ISBLANK ( _cur ), BLANK (), DIVIDE ( _cur, _prev ) - 1 )
		formatString: 0.0%
		displayFolder: 8 Çeyreklik (nominal)
		lineageTag: 66b19295-ccb2-5a9a-a49a-0ace04493eab

	measure 'Revenue TTM (nominal)' =
			VAR _idx = [Selected Index]
			RETURN
			    CALCULATE (
			        SUM ( fact_quarterly[revenue_q] ),
			        FILTER ( ALL ( dim_date ), dim_date[period_index] > _idx - 4 && dim_date[period_index] <= _idx )
			    )
		formatString: #,##0
		displayFolder: 8 Çeyreklik (nominal)
		lineageTag: 2ed0bb52-72ab-57b2-b955-2de30b33eeb5

	measure 'EBITDA TTM (nominal)' =
			VAR _idx = [Selected Index]
			RETURN
			    CALCULATE (
			        SUM ( fact_quarterly[ebitda_q] ),
			        FILTER ( ALL ( dim_date ), dim_date[period_index] > _idx - 4 && dim_date[period_index] <= _idx )
			    )
		formatString: #,##0
		displayFolder: 8 Çeyreklik (nominal)
		lineageTag: dc9f2033-630a-548f-9bda-8177059c0ad7

	measure 'Quarter Basis OK' =
			VAR _d = [Selected Date Key]
			RETURN
			    IF ( CALCULATE ( MIN ( fact_quarterly[qoq_basis_ok] ), dim_date[date_key] = _d ) = 1, 1, 0 )
		formatString: 0
		displayFolder: 8 Çeyreklik (nominal)
		lineageTag: d7bf1095-5982-5bbd-ba14-435bcd7cd943

	measure 'Revenue YTD PY' =
			VAR _d = [Selected Date Key]
			RETURN
			    CALCULATE ( SUM ( fact_ratios[revenue] ), ALL ( dim_date ), dim_date[date_key] = _d - 100 )
		formatString: #,##0
		displayFolder: 9 Büyüme (nominal)
		lineageTag: 050d6700-c91f-509c-9a34-9b93d7990048

	measure 'Revenue Growth YoY (nominal)' =
			VAR _cy = [Revenue YTD]
			VAR _py = [Revenue YTD PY]
			RETURN
			    IF ( ISBLANK ( _py ) || ISBLANK ( _cy ), BLANK (), DIVIDE ( _cy, _py ) - 1 )
		formatString: 0.0%
		displayFolder: 9 Büyüme (nominal)
		lineageTag: 813ec411-f694-51ed-a128-8b51ac5265ac

	measure 'Growth Comparability' =
			VAR _d = [Selected Date Key]
			VAR _break =
			    CALCULATE ( COUNTROWS ( fact_growth ), fact_growth[comparability] = "BASE_BREAK", dim_date[date_key] = _d )
			RETURN
			    IF ( _break > 0, "BASE_BREAK", IF ( _d >= 202312, "NOMINAL_TMS29", "NOMINAL" ) )
		displayFolder: 9 Büyüme (nominal)
		lineageTag: 1e55be93-4822-5dfc-8b17-adb9d687c4b9

	measure 'Growth Font Color' = IF ( [Growth Comparability] = "BASE_BREAK", "#B3B3B3", "#252423" )
		displayFolder: 9 Büyüme (nominal)
		lineageTag: d2575a66-09ac-58f3-b64f-368418e58d21

	measure 'TMS29 Banner' =
			IF (
			    [Selected Date Key] >= 202312,
			    "TMS 29 dönemi: dönemler arası büyüme ve çeyreklik farklar nominal",
			    "TMS 29 öncesi dönem: değerler nominal TL"
			)
		displayFolder: A Uyarılar
		lineageTag: b4c9518e-d2a6-5995-b918-9bf087537f8f

	measure 'Known Issue Count' =
			VAR _p = [Selected Period]
			RETURN
			    CALCULATE (
			        COUNTROWS ( known_issues ),
			        TREATAS ( VALUES ( dim_company[ticker] ), known_issues[ticker] ),
			        known_issues[period_label] = _p
			    )
		formatString: 0
		displayFolder: A Uyarılar
		lineageTag: 22e50f72-08fd-597d-bde4-0c2160db2baa

	measure 'Data Issue Banner' =
			IF (
			    [Known Issue Count] > 0,
			    "UYARI: Seçili şirket/dönem için kaynak veride bilinen bir sorun var (known_issues).",
			    "Seçili şirket/dönem için kayıtlı kaynak veri sorunu yok."
			)
		displayFolder: A Uyarılar
		lineageTag: 1fed1cab-46ff-577b-9c12-327503c5f05e

	measure 'Growth Banner' =
			SWITCH (
			    [Growth Comparability],
			    "BASE_BREAK", "Büyüme karşılaştırması güvenilir değil (kaynakta baz kırılması); gri gösterilir.",
			    "NOMINAL_TMS29", "Büyüme nominal TL'dir; reel büyüme değildir.",
			    "Büyüme nominal TL'dir."
			)
		displayFolder: A Uyarılar
		lineageTag: 654daee0-9f0a-5596-9542-170e969fa74d

	measure 'Blank Ratio Note' = "Boş oran = anlamsız: FAVÖK marjı %1'in altında ya da özkaynak sıfır/negatif"
		displayFolder: A Uyarılar
		lineageTag: 1a2af1cb-0f30-5b0d-9f36-7c7947336abe

	measure Footnotes = "Kaynak: İş Yatırım (isyatirimhisse, resmî olmayan kaynak); kritik rakamlar KAP ile doğrulanmalı. " & "TMS 29 (2023/12 ve sonrası): kolonlar arası büyüme ve çeyreklik farklar nominaldir; marj, likidite ve kaldıraç aynı dönem kolonu içinde hesaplandığı için etkilenmez. " & "2022/12, 2025/9 ve 2025/12 kolonlarında kaynak veride baz kırılması var (dw.known_data_issues)."
		displayFolder: A Uyarılar
		lineageTag: 04bcd9e3-9fad-520d-9a70-f46ba9fbe957

	measure 'DQ Total Checks' = COUNTROWS ( dq_results )
		formatString: 0
		displayFolder: B Veri kalitesi
		lineageTag: 6e732786-3b33-50cf-bbbf-31369108447d

	measure 'DQ Pass' =
			VAR _n = CALCULATE ( COUNTROWS ( dq_results ), dq_results[result] = "PASS" )
			RETURN
			    IF ( ISBLANK ( _n ), 0, _n )
		formatString: 0
		displayFolder: B Veri kalitesi
