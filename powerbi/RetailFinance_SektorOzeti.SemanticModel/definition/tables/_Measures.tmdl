	measure 'Gross Margin Rank' =
			IF (
			    NOT ISBLANK ( [Gross Margin] ),
			    RANKX (
			        FILTER ( ALL ( dim_company[short_name] ), NOT ISBLANK ( [Gross Margin] ) ),
			        [Gross Margin], , DESC, DENSE
			    )
