model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: tr-TR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_company", "dim_date", "fact_ratios", "fact_quarterly", "fact_growth", "known_issues", "dq_results", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table dim_company
ref table dim_date
ref table fact_ratios
ref table fact_quarterly
ref table fact_growth
ref table known_issues
ref table dq_results
ref table _Measures

ref cultureInfo en-US

